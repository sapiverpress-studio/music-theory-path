{
  "expo": {
    "name": "Sapiver Music",
    "slug": "music-theory-path",
    "owner": "sapiverforge",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
